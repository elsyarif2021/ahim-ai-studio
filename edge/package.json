{
  "name": "ahim-cloudflare-edge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node --check src/index.js && node --check src/auth.js && node --check src/security.js && node --check src/api.js && node --check test/api.spec.js",
    "test": "vitest run",
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "migrate:local": "wrangler d1 migrations apply ahim-edge-staging --local",
    "migrate:remote": "wrangler d1 migrations apply ahim-edge-staging --remote",
    "deploy:staging": "wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.10.0",
    "jose": "^6.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "wrangler": "^4.45.0",
    "vitest": "^4.1.0",
    "@cloudflare/vitest-plugin": "^1.0.0"
  }
}
