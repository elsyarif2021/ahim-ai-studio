{
  "functions": {
    "api/ai.js": {
      "maxDuration": 60
    },
    "api/voices.js": {
      "maxDuration": 20
    },
    "api/video.js": {
      "maxDuration": 60
    },
    "api/agensi.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
